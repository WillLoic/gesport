# E-Commerce & Merchandising Service Configuration
# Copy this file to .env and update with your actual values
# NEVER commit the .env file!

# Django Security
SECRET_KEY=django-insecure-gesport-ecommerce-merchandising-secret-key-2026-local-dev
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,shop.gesport.local

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://gesport.local

# Payment Processing
STRIPE_API_KEY=your-stripe-key
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
