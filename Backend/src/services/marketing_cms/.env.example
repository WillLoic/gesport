# Marketing CMS Service Configuration
# Copy this file to .env and update with your actual values
# NEVER commit the .env file!

# Django Security
SECRET_KEY=django-insecure-gesport-marketing-cms-secret-key-2026-local-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,cms.gesport.local

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cms_db
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True

# Celery (Redis Broker)
CELERY_BROKER_URL=redis://localhost:6379/7
CELERY_RESULT_BACKEND=redis://localhost:6379/7

# Brevo (Email & SMS campaigns)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@gesport.com
BREVO_SENDER_NAME=GESPORT

# Geskap (WhatsApp campaigns)
GESKAP_API_URL=https://api.geskap.com
GESKAP_API_KEY=your-geskap-api-key-here

# Logging
LOG_LEVEL=INFO
