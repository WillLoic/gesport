# Configuration locale du service auth_iam

# Django Security
SECRET_KEY=django-insecure-gesport-auth-iam-secret-key-2026-local-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de données (SQLite en dev local / PostgreSQL en docker)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=auth_db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True

# Email (Console backend pour le dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@gesport.fr

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
