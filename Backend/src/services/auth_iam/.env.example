# Variables d'environnement du service auth_iam
# Copiez ce fichier en .env et remplissez les valeurs

# Django
SECRET_KEY=your-super-secret-key-here-change-it-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL (auth_db)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=auth_db
DB_USER=gesport_user
DB_PASSWORD=gesport_password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True
# En prod, désactiver la ligne ci-dessus et renseigner :
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.gesport.fr

# Email (dev: console / prod: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@gesport.fr

# Redis + Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
